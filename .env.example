# Copy to .env and fill in.

# Backend: "anthropic" (Claude, needs credits) or "ollama" (free local model, https://ollama.com)
LLM_PROVIDER=ollama

# Anthropic: get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Ollama: pull the model first with `ollama pull qwen2.5:7b`
OLLAMA_MODEL=qwen2.5:7b
